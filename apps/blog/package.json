{
	"name": "blog",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"build": "next build --webpack",
		"dev": "next dev --turbopack --port 3000",
		"export": "next export",
		"fmt": "prettier --write .",
		"lint": "eslint .",
		"postinstall": "drizzle-kit generate",
		"r2:upload": "rclone copy public/images r2:static/blog/images",
		"start": "next start",
		"studio": "drizzle-kit studio",
		"test": "vitest run",
		"typecheck": "next typegen && tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.11",
		"@libsql/client": "^0.17.4",
		"@monaco-editor/react": "^4.7.0",
		"@tailwindcss/typography": "^0.5.20",
		"@vstack/ai": "workspace:*",
		"@vstack/ui": "workspace:*",
		"ai": "^7.0.22",
		"babel-plugin-react-compiler": "1.0.0",
		"drizzle-orm": "^0.45.2",
		"next": "16.2.11",
		"next-auth": "^4.24.15",
		"posthog-js": "^1.399.2",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^16.1.1",
		"remark-gfm": "^4.0.1",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"core-js",
			"esbuild",
			"protobufjs",
			"sharp",
			"unrs-resolver"
		]
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"autoprefixer": "^10.5.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.2.10",
		"postcss": "8.5.18",
		"prettier": "^3.9.5",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
